# 七牛云凭据 —— 复制为 .env 或直接导出到环境变量后由插件读取。
#
# 注意：这里填的是【值】。插件配置里的 accessKeyRef / secretKeyRef 填的是
# 下面的【变量名】（QINIU_ACCESS_KEY / QINIU_SECRET_KEY）。
#
# 两项都可以改成任意 POSIX 环境变量名，只要与插件配置里的 ref 一致即可。

# 七牛 AccessKey（AK），账号级管理凭证
QINIU_ACCESS_KEY=

# 七牛 SecretKey（SK）—— 绝不提交到仓库，绝不写进日志
QINIU_SECRET_KEY=

# 可选：某个具体 API Key 的 sk-/tk- token，用于 Bearer 精确查询单个 Key。
# 对应的 ref 名在 apiKeys[].tokenRef 里声明。
# QINIU_TOKEN_MY_KEY=
